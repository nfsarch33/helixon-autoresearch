# Notification System Configuration
# Copy to .env and fill in values

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get chat ID by sending /start to your bot, then visiting:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Email Configuration - Resend (Primary)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@example.com
RESEND_TO_EMAIL=ops@example.com

# Email Configuration - Brevo (Fallback)
# Get API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_FROM_EMAIL=alerts@example.com
BREVO_TO_EMAIL=ops@example.com

# Webhook Configuration (Optional)
WEBHOOK_URL=

# Severity Routing Rules:
# P0 (Critical): Telegram + Email
# P1 (High): Telegram + Email
# P2 (Medium): Email only
# P3 (Low): Email only
# P4 (Debug): Email only
